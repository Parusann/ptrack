# Copy this file to .env and fill in real values. Never commit .env.

# Database (Neon pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# FedEx Track API (use https://apis-sandbox.fedex.com for sandbox keys)
FEDEX_API_URL=https://apis.fedex.com
FEDEX_API_KEY=
FEDEX_SECRET_KEY=

# UPS Tracking API (OAuth client credentials)
UPS_API_URL=https://onlinetools.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# DHL Shipment Tracking - Unified
DHL_API_KEY=

# Canada Post Developer Portal
CANADAPOST_CUSTOMER_NUMBER=
CANADAPOST_API_KEY=
CANADAPOST_API_SECRET=

# 17TRACK fallback (optional)
SEVENTEENTRACK_API_KEY=

# Geocoding fallback
GEOAPIFY_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auth
JWT_SECRET=change-me
